-- Tous les réglages du jeu sont ici : modifie-les pour rendre le jeu plus ou moins dur.

local Config = {
	-- Labyrinthe
	CELL_SIZE = 16, -- taille d'une case en studs
	MAZE_WIDTH = 12, -- nombre de cases en X
	MAZE_HEIGHT = 12, -- nombre de cases en Z
	WALL_HEIGHT = 12,
	BRAID_RATIO = 0.12, -- proportion de murs supprimés en plus (crée des boucles pour semer le monstre)
	LAMP_RATIO = 0.14, -- proportion de cases avec une lampe au plafond

	-- Partie
	KEY_COUNT = 5,
	MIN_PLAYERS = 1,
	INTERMISSION = 15, -- secondes dans le lobby avant une manche
	ROUND_TIME = 300, -- durée max d'une manche (secondes)

	-- Joueur
	WALK_SPEED = 12,
	SPRINT_SPEED = 20,
	STAMINA_MAX = 100,
	STAMINA_DRAIN = 22, -- par seconde en courant
	STAMINA_REGEN = 14, -- par seconde sans courir
	BATTERY_MAX = 100,
	BATTERY_DRAIN = 2.2, -- par seconde lampe allumée
	BATTERY_REGEN = 1.2, -- par seconde lampe éteinte

	-- Monstre
	MONSTER_GRACE = 12, -- secondes avant que le monstre se réveille
	MONSTER_WANDER_SPEED = 8,
	MONSTER_CHASE_SPEED = 16,
	MONSTER_ENRAGE_PER_KEY = 0.6, -- vitesse en plus par clé ramassée
	MONSTER_SIGHT_RANGE = 45, -- portée de vue si le joueur est dans le noir
	MONSTER_SIGHT_RANGE_LIGHT = 85, -- portée de vue si la lampe du joueur est allumée
	MONSTER_HEAR_RANGE = 30, -- entend les joueurs qui courent
	MONSTER_SENSE_RANGE = 9, -- sent toujours les joueurs très proches
	MONSTER_KILL_RANGE = 4.5,

	-- Sons (optionnels) : colle ici des ID de sons du Creator Store, ex. "rbxassetid://1234567890"
	-- Laisser vide = pas de son (le jeu fonctionne quand même).
	SOUNDS = {
		Ambient = "", -- ambiance en boucle
		Heartbeat = "", -- battements de cœur (boucle)
		Scream = "", -- cri du screamer
		Sting = "", -- son quand le monstre te repère
		Whisper = "", -- chuchotements
		KeyPickup = "", -- ramassage de clé
		Flashlight = "", -- clic de la lampe
	},
}

return Config
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX00000006"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Maze</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- Maze (ModuleScript dans ServerScriptService)
-- Génération de labyrinthe (backtracker récursif + boucles) et recherche de chemin (BFS).

local Maze = {}

export type Cell = { N: boolean, S: boolean, E: boolean, W: boolean, visited: boolean }
export type MazeData = { width: number, height: number, cells: { { Cell } } }

local DIRS = {
	{ dx = 0, dz = -1, wall = "N", opp = "S" },
	{ dx = 0, dz = 1, wall = "S", opp = "N" },
	{ dx = 1, dz = 0, wall = "E", opp = "W" },
	{ dx = -1, dz = 0, wall = "W", opp = "E" },
}

local function inBounds(maze: MazeData, x: number, z: number): boolean
	return x >= 1 and x <= maze.width and z >= 1 and z <= maze.height
end

function Maze.generate(width: number, height: number, braidRatio: number, rng: Random): MazeData
	local cells = {}
	for x = 1, width do
		cells[x] = {}
		for z = 1, height do
			cells[x][z] = { N = true, S = true, E = true, W = true, visited = false }
		end
	end
	local maze: MazeData = { width = width, height = height, cells = cells }

	-- Backtracker récursif (itératif avec une pile)
	local stack = { { 1, 1 } }
	cells[1][1].visited = true
	while #stack > 0 do
		local cur = stack[#stack]
		local cx, cz = cur[1], cur[2]
		local options = {}
		for _, d in DIRS do
			local nx, nz = cx + d.dx, cz + d.dz
			if inBounds(maze, nx, nz) and not cells[nx][nz].visited then
				table.insert(options, d)
			end
		end
		if #options == 0 then
			table.remove(stack)
		else
			local d = options[rng:NextInteger(1, #options)]
			local nx, nz = cx + d.dx, cz + d.dz
			cells[cx][cz][d.wall] = false
			cells[nx][nz][d.opp] = false
			cells[nx][nz].visited = true
			table.insert(stack, { nx, nz })
		end
	end

	-- Supprime quelques murs en plus pour créer des boucles (sinon impossible de semer le monstre)
	for _ = 1, math.floor(width * height * braidRatio) do
		local x, z = rng:NextInteger(1, width), rng:NextInteger(1, height)
		local d = DIRS[rng:NextInteger(1, 4)]
		local nx, nz = x + d.dx, z + d.dz
		if inBounds(maze, nx, nz) then
			cells[x][z][d.wall] = false
			cells[nx][nz][d.opp] = false
		end
	end

	return maze
end

function Maze.openNeighbors(maze: MazeData, x: number, z: number): { { number } }
	local c = maze.cells[x][z]
	local res = {}
	if not c.N then table.insert(res, { x, z - 1 }) end
	if not c.S then table.insert(res, { x, z + 1 }) end
	if not c.E then table.insert(res, { x + 1, z }) end
	if not c.W then table.insert(res, { x - 1, z }) end
	return res
end

local function key(x: number, z: number): number
	return x * 10000 + z
end

-- Renvoie la liste des cases de (sx,sz) exclue à (tx,tz) incluse. {} si déjà dessus.
function Maze.findPath(maze: MazeData, sx: number, sz: number, tx: number, tz: number): { { number } }
	if sx == tx and sz == tz then
		return {}
	end
	local prev = { [key(sx, sz)] = false }
	local queue = { { sx, sz } }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		if cur[1] == tx and cur[2] == tz then
			local path = {}
			local node = cur
			while node and not (node[1] == sx and node[2] == sz) do
				table.insert(path, 1, node)
				node = prev[key(node[1], node[2])]
			end
			return path
		end
		for _, n in Maze.openNeighbors(maze, cur[1], cur[2]) do
			local k = key(n[1], n[2])
			if prev[k] == nil then
				prev[k] = cur
				table.insert(queue, n)
			end
		end
	end
	return {}
end

-- Distance (en cases) depuis (sx,sz) vers toutes les cases
function Maze.distances(maze: MazeData, sx: number, sz: number): { { number } }
	local dist = {}
	for x = 1, maze.width do
		dist[x] = {}
	end
	dist[sx][sz] = 0
	local queue = { { sx, sz } }
	local head = 1
	while head <= #queue do
		local cur = queue[head]
		head += 1
		for _, n in Maze.openNeighbors(maze, cur[1], cur[2]) do
			if dist[n[1]][n[2]] == nil then
				dist[n[1]][n[2]] = dist[cur[1]][cur[2]] + 1
				table.insert(queue, n)
			end
		end
	end
	return dist
end

function Maze.isDeadEnd(maze: MazeData, x: number, z: number): boolean
	return #Maze.openNeighbors(maze, x, z) == 1
end

return Maze
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX00000005"><Properties><string name="Name">HorrorServer</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HorrorServer (Script dans ServerScriptService)
-- Génère l'asile, gère les manches, les clés, la sortie et l'IA du monstre.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("HorrorConfig"))
local Maze = require(script.Parent:WaitForChild("Maze"))

local S = Config.CELL_SIZE
local H = Config.WALL_HEIGHT
local W_CELLS = Config.MAZE_WIDTH
local H_CELLS = Config.MAZE_HEIGHT
local ORIGIN = Vector3.new(0, 0, 0)
local LOBBY_POS = Vector3.new(0, 150, 0)
local MONSTER_Y = 4.5

local RED = Color3.fromRGB(200, 30, 30)
local GOLD = Color3.fromRGB(255, 200, 60)
local GREEN = Color3.fromRGB(80, 220, 110)

local WALL_TEXTS = {
	"IL TE VOIT", "NE COURS PAS", "SORS D'ICI", "TROP TARD", "IL EST DERRIÈRE TOI",
	"5 CLÉS", "PAS DE SORTIE", "AIDE-MOI", "ÉTEINS TA LAMPE", "ON NE SORT JAMAIS",
}

----------------------------------------------------------------------
-- Remote + état partagé (attributs répliqués aux clients)
----------------------------------------------------------------------
local remote = Instance.new("RemoteEvent")
remote.Name = "HorrorEvent"
remote.Parent = ReplicatedStorage

local function setState(name: string, value: any)
	ReplicatedStorage:SetAttribute(name, value)
end

local function broadcast(text: string, color: Color3?, duration: number?)
	remote:FireAllClients("Message", text, color or Color3.new(1, 1, 1), duration or 3)
end

local function tell(player: Player, text: string, color: Color3?, duration: number?)
	remote:FireClient(player, "Message", text, color or Color3.new(1, 1, 1), duration or 3)
end

----------------------------------------------------------------------
-- Ambiance
----------------------------------------------------------------------
local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end
	Lighting.ClockTime = 0
	Lighting.Brightness = 0
	Lighting.Ambient = Color3.new(0, 0, 0)
	Lighting.OutdoorAmbient = Color3.fromRGB(8, 8, 12)
	Lighting.EnvironmentDiffuseScale = 0
	Lighting.EnvironmentSpecularScale = 0
	Lighting.GlobalShadows = true
	Lighting.FogStart = 0
	Lighting.FogEnd = 90
	Lighting.FogColor = Color3.new(0, 0, 0)

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = -0.35
	cc.Contrast = 0.15
	cc.TintColor = Color3.fromRGB(225, 230, 255)
	cc.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 30
	bloom.Threshold = 0.9
	bloom.Parent = Lighting
end

----------------------------------------------------------------------
-- Helpers de construction
----------------------------------------------------------------------
local function makePart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function addSurfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3, rotation: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 1
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(0.8, 0.35)
	label.Position = UDim2.fromScale(0.1, 0.3)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = Enum.Font.Creepster
	label.TextColor3 = color
	label.Rotation = rotation or 0
	label.Parent = gui
end

local function cellCenter(x: number, z: number): Vector3
	return ORIGIN + Vector3.new((x - 0.5) * S, 0, (z - 0.5) * S)
end

local function worldToCell(pos: Vector3): (number, number)
	local x = math.clamp(math.floor((pos.X - ORIGIN.X) / S) + 1, 1, W_CELLS)
	local z = math.clamp(math.floor((pos.Z - ORIGIN.Z) / S) + 1, 1, H_CELLS)
	return x, z
end

----------------------------------------------------------------------
-- Lobby
----------------------------------------------------------------------
local lobbySpawn: SpawnLocation

local function buildLobby()
	-- Supprime le Baseplate et les spawns du template par défaut
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	for _, d in workspace:GetDescendants() do
		if d:IsA("SpawnLocation") then
			d:Destroy()
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Lobby"
	folder.Parent = workspace

	local size = 40
	local wallColor = Color3.fromRGB(45, 40, 40)
	makePart({ Name = "Floor", Size = Vector3.new(size, 1, size), Position = LOBBY_POS - Vector3.new(0, 0.5, 0),
		Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(60, 45, 35), Parent = folder })
	makePart({ Name = "Ceiling", Size = Vector3.new(size, 1, size), Position = LOBBY_POS + Vector3.new(0, 14.5, 0),
		Color = Color3.fromRGB(20, 20, 20), Parent = folder })
	for i, offset in { Vector3.new(size / 2, 7, 0), Vector3.new(-size / 2, 7, 0), Vector3.new(0, 7, size / 2), Vector3.new(0, 7, -size / 2) } do
		local wall = makePart({
			Name = "Wall" .. i,
			Size = if offset.X ~= 0 then Vector3.new(1, 14, size) else Vector3.new(size, 14, 1),
			Position = LOBBY_POS + offset,
			Material = Enum.Material.Brick,
			Color = wallColor,
			Parent = folder,
		})
		if i == 4 then
			-- Mur nord : panneau titre (face Back = +Z, vers l'intérieur)
			addSurfaceText(wall, Enum.NormalId.Back, "L'ASILE DES OMBRES", RED)
		end
	end

	local lamp = makePart({ Name = "Lamp", Size = Vector3.new(3, 0.4, 3), Position = LOBBY_POS + Vector3.new(0, 13.8, 0),
		Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 190, 120), CanCollide = false, Parent = folder })
	local light = Instance.new("PointLight")
	light.Range = 35
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(255, 180, 110)
	light.Shadows = true
	light.Parent = lamp

	lobbySpawn = Instance.new("SpawnLocation")
	lobbySpawn.Name = "LobbySpawn"
	lobbySpawn.Anchored = true
	lobbySpawn.Size = Vector3.new(8, 1, 8)
	lobbySpawn.Position = LOBBY_POS + Vector3.new(0, 0.05, 0)
	lobbySpawn.Material = Enum.Material.Slate
	lobbySpawn.Color = Color3.fromRGB(30, 30, 30)
	lobbySpawn.Duration = 0
	lobbySpawn.Neutral = true
	lobbySpawn.Parent = folder
end

local function sendToLobby(player: Player)
	local char = player.Character
	if not char then
		return
	end
	char:SetAttribute("Frozen", nil)
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = false
	end
	local offset = Vector3.new(math.random(-12, 12), 4, math.random(-12, 12))
	char:PivotTo(CFrame.new(LOBBY_POS + offset))
end

----------------------------------------------------------------------
-- Construction du labyrinthe
----------------------------------------------------------------------
type Lamp = { part: BasePart, light: PointLight }

local function buildMap(maze: Maze.MazeData, rng: Random)
	local folder = Instance.new("Folder")
	folder.Name = "Asylum"

	local totalX, totalZ = W_CELLS * S, H_CELLS * S
	local mid = ORIGIN + Vector3.new(totalX / 2, 0, totalZ / 2)

	makePart({ Name = "Floor", Size = Vector3.new(totalX + 2, 1, totalZ + 2), Position = mid - Vector3.new(0, 0.5, 0),
		Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(45, 32, 25), Parent = folder })
	makePart({ Name = "Ceiling", Size = Vector3.new(totalX + 2, 1, totalZ + 2), Position = mid + Vector3.new(0, H + 0.5, 0),
		Material = Enum.Material.Concrete, Color = Color3.fromRGB(25, 25, 25), Parent = folder })

	local walls = Instance.new("Folder")
	walls.Name = "Walls"
	walls.Parent = folder

	local function wall(pos: Vector3, size: Vector3, faces: { Enum.NormalId })
		local p = makePart({
			Size = size,
			Position = pos,
			Material = Enum.Material.Concrete,
			Color = Color3.fromRGB(70 + rng:NextInteger(-8, 8), 66, 60),
			Parent = walls,
		})
		if rng:NextNumber() < 0.07 then
			local text = WALL_TEXTS[rng:NextInteger(1, #WALL_TEXTS)]
			addSurfaceText(p, faces[rng:NextInteger(1, #faces)], text, Color3.fromRGB(120, 0, 0), rng:NextInteger(-8, 8))
		end
		return p
	end

	local exitX, exitZ = W_CELLS, H_CELLS
	for x = 1, W_CELLS do
		for z = 1, H_CELLS do
			local c = maze.cells[x][z]
			local center = cellCenter(x, z)
			local y = H / 2
			if c.N then
				wall(center + Vector3.new(0, y, -S / 2), Vector3.new(S + 1, H, 1), { Enum.NormalId.Front, Enum.NormalId.Back })
			end
			if c.W then
				wall(center + Vector3.new(-S / 2, y, 0), Vector3.new(1, H, S + 1), { Enum.NormalId.Left, Enum.NormalId.Right })
			end
			if x == W_CELLS and c.E then
				wall(center + Vector3.new(S / 2, y, 0), Vector3.new(1, H, S + 1), { Enum.NormalId.Left })
			end
			if z == H_CELLS and c.S and not (x == exitX and z == exitZ) then
				wall(center + Vector3.new(0, y, S / 2), Vector3.new(S + 1, H, 1), { Enum.NormalId.Front })
			end
		end
	end

	-- Porte de sortie (mur sud de la dernière case)
	local exitCenter = cellCenter(exitX, exitZ) + Vector3.new(0, 0, S / 2)
	local doorW, doorH = 7, 10
	local side = (S + 1 - doorW) / 2
	for _, sign in { -1, 1 } do
		makePart({ Size = Vector3.new(side, H, 1), Position = exitCenter + Vector3.new(sign * (doorW / 2 + side / 2), H / 2, 0),
			Material = Enum.Material.Concrete, Color = Color3.fromRGB(60, 56, 52), Parent = folder })
	end
	local header = makePart({ Size = Vector3.new(doorW, H - doorH, 1), Position = exitCenter + Vector3.new(0, doorH + (H - doorH) / 2, 0),
		Material = Enum.Material.Concrete, Color = Color3.fromRGB(60, 56, 52), Parent = folder })
	addSurfaceText(header, Enum.NormalId.Front, "SORTIE", RED)
	local door = makePart({ Name = "ExitDoor", Size = Vector3.new(doorW, doorH, 1), Position = exitCenter + Vector3.new(0, doorH / 2, 0),
		Material = Enum.Material.DiamondPlate, Color = Color3.fromRGB(90, 20, 20), Parent = folder })
	local doorLight = Instance.new("PointLight")
	doorLight.Color = RED
	doorLight.Range = 14
	doorLight.Brightness = 1.5
	doorLight.Parent = header

	-- Lampes au plafond + taches de sang
	local lamps: { Lamp } = {}
	for x = 1, W_CELLS do
		for z = 1, H_CELLS do
			local center = cellCenter(x, z)
			if rng:NextNumber() < Config.LAMP_RATIO then
				local lampPart = makePart({ Name = "Lamp", Size = Vector3.new(2, 0.3, 2), Position = center + Vector3.new(0, H - 0.15, 0),
					Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 200, 140), CanCollide = false, Parent = folder })
				local light = Instance.new("PointLight")
				light.Range = 18
				light.Brightness = 1.1
				light.Color = Color3.fromRGB(255, 190, 130)
				light.Shadows = true
				light.Parent = lampPart
				if rng:NextNumber() < 0.25 then
					-- lampe morte
					light.Enabled = false
					lampPart.Material = Enum.Material.SmoothPlastic
					lampPart.Color = Color3.fromRGB(40, 40, 40)
				else
					table.insert(lamps, { part = lampPart, light = light })
				end
			end
			if rng:NextNumber() < 0.2 then
				local d = rng:NextNumber(2, 5)
				makePart({ Name = "Blood", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, d, d),
					CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-4, 4), 0.03, rng:NextNumber(-4, 4))) * CFrame.Angles(0, 0, math.pi / 2),
					Material = Enum.Material.SmoothPlastic, Color = Color3.fromRGB(70, 0, 0), CanCollide = false, CanQuery = false, Parent = folder })
			end
		end
	end

	return folder, door, doorLight, lamps
end

----------------------------------------------------------------------
-- Monstre
----------------------------------------------------------------------
local function buildMonster(): Model
	local model = Instance.new("Model")
	model.Name = "TheEntity"
	local black = Color3.fromRGB(8, 8, 10)

	local function part(name: string, size: Vector3, offset: Vector3, color: Color3, material: Enum.Material?)
		local p = makePart({
			Name = name, Size = size, CFrame = CFrame.new(offset), Color = color,
			Material = material or Enum.Material.SmoothPlastic,
			CanCollide = false, CanTouch = false, CanQuery = false, Parent = model,
		})
		return p
	end

	local root = part("Root", Vector3.new(2, 2, 1), Vector3.zero, black)
	root.Transparency = 1
	model.PrimaryPart = root
	part("Torso", Vector3.new(2.2, 4.5, 1.1), Vector3.new(0, 1.5, 0), black, Enum.Material.Fabric)
	local head = part("Head", Vector3.new(1.8, 2.2, 1.8), Vector3.new(0, 4.9, 0), black)
	part("EyeL", Vector3.new(0.4, 0.22, 0.1), Vector3.new(-0.42, 5.15, -0.92), Color3.fromRGB(255, 0, 0), Enum.Material.Neon)
	part("EyeR", Vector3.new(0.4, 0.22, 0.1), Vector3.new(0.42, 5.15, -0.92), Color3.fromRGB(255, 0, 0), Enum.Material.Neon)
	part("Mouth", Vector3.new(1.1, 0.5, 0.1), Vector3.new(0, 4.3, -0.92), Color3.fromRGB(40, 0, 0), Enum.Material.Neon)
	part("ArmL", Vector3.new(0.45, 7, 0.45), Vector3.new(-1.4, 0.3, 0), black)
	part("ArmR", Vector3.new(0.45, 7, 0.45), Vector3.new(1.4, 0.3, 0), black)
	part("LegL", Vector3.new(0.7, 4, 0.7), Vector3.new(-0.6, -2.5, 0), black)
	part("LegR", Vector3.new(0.7, 4, 0.7), Vector3.new(0.6, -2.5, 0), black)

	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 20, 20)
	glow.Range = 12
	glow.Brightness = 2
	glow.Parent = head

	return model
end

----------------------------------------------------------------------
-- Manche
----------------------------------------------------------------------
local alive: { [Player]: boolean } = {} -- joueurs encore dans l'asile
local escaped: { Player } = {}
local flashlightOn: { [Player]: boolean } = {}
local roundId = 0
local keysCollected = 0
local currentMaze: Maze.MazeData? = nil

type MonsterState = {
	model: Model,
	pos: Vector3,
	facing: Vector3,
	path: { { number } },
	mode: string, -- "wander" | "chase" | "search"
	target: Player?,
	lastKnown: { number }?,
	thinkTimer: number,
	pauseUntil: number,
}
local monster: MonsterState? = nil

local function getRoot(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function inMazeCount(): number
	local n = 0
	for _ in alive do
		n += 1
	end
	return n
end

local function removeFromMaze(player: Player)
	alive[player] = nil
	player:SetAttribute("InMaze", false)
end

local function killPlayer(player: Player)
	if not alive[player] then
		return
	end
	removeFromMaze(player)
	local char = player.Character
	if char then
		char:SetAttribute("Frozen", true)
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			root.Anchored = true
		end
	end
	remote:FireClient(player, "Jumpscare")
	broadcast(player.DisplayName .. " a été attrapé...", RED, 3)
	task.delay(2.6, function()
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if hum and hum.Parent then
			hum.Health = 0
		end
	end)
end

local function monsterSpeed(state: MonsterState): number
	if state.mode == "chase" then
		return Config.MONSTER_CHASE_SPEED + keysCollected * Config.MONSTER_ENRAGE_PER_KEY
	elseif state.mode == "search" then
		return (Config.MONSTER_CHASE_SPEED + Config.MONSTER_WANDER_SPEED) / 2
	end
	return Config.MONSTER_WANDER_SPEED
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function canSee(state: MonsterState, player: Player, root: BasePart): boolean
	local eye = state.pos + Vector3.new(0, 3, 0)
	local target = root.Position + Vector3.new(0, 1.5, 0)
	rayParams.FilterDescendantsInstances = { state.model }
	local result = workspace:Raycast(eye, target - eye, rayParams)
	return result == nil or (player.Character ~= nil and result.Instance:IsDescendantOf(player.Character))
end

local function think(state: MonsterState, maze: Maze.MazeData)
	local mx, mz = worldToCell(state.pos)
	local best: Player? = nil
	local bestDist = math.huge
	for player in alive do
		local root = getRoot(player)
		if root then
			local d = (root.Position - state.pos).Magnitude
			local vel = root.AssemblyLinearVelocity
			local running = Vector3.new(vel.X, 0, vel.Z).Magnitude > Config.WALK_SPEED + 2
			local sight = if flashlightOn[player] then Config.MONSTER_SIGHT_RANGE_LIGHT else Config.MONSTER_SIGHT_RANGE
			local detected = d < Config.MONSTER_SENSE_RANGE
				or (d < sight and canSee(state, player, root))
				or (d < Config.MONSTER_HEAR_RANGE and running)
			if detected and d < bestDist then
				best, bestDist = player, d
			end
		end
	end

	if best then
		local root = getRoot(best) :: BasePart
		if state.mode ~= "chase" or state.target ~= best then
			remote:FireClient(best, "Spotted")
		end
		state.mode = "chase"
		state.target = best
		local px, pz = worldToCell(root.Position)
		state.lastKnown = { px, pz }
		state.path = Maze.findPath(maze, mx, mz, px, pz)
	elseif state.mode == "chase" and state.lastKnown then
		-- Cible perdue : va voir le dernier endroit connu
		state.mode = "search"
		state.target = nil
		state.path = Maze.findPath(maze, mx, mz, state.lastKnown[1], state.lastKnown[2])
	elseif #state.path == 0 then
		state.mode = "wander"
		state.target = nil
		local tx, tz = math.random(1, W_CELLS), math.random(1, H_CELLS)
		-- Instinct de chasseur : se dirige parfois vers un joueur au hasard
		if math.random() < 0.4 then
			local list = {}
			for p in alive do
				table.insert(list, p)
			end
			local root = #list > 0 and getRoot(list[math.random(1, #list)])
			if root then
				tx, tz = worldToCell(root.Position)
			end
		end
		state.path = Maze.findPath(maze, mx, mz, tx, tz)
	end
end

local function updateMonster(state: MonsterState, maze: Maze.MazeData, dt: number)
	if os.clock() < state.pauseUntil then
		return
	end

	state.thinkTimer -= dt
	if state.thinkTimer <= 0 then
		state.thinkTimer = 0.25
		think(state, maze)
	end

	-- Déplacement
	local targetPos: Vector3? = nil
	local direct = false
	if state.mode == "chase" and state.target then
		local root = getRoot(state.target)
		if root then
			local px, pz = worldToCell(root.Position)
			local mx, mz = worldToCell(state.pos)
			if px == mx and pz == mz then
				targetPos = Vector3.new(root.Position.X, MONSTER_Y, root.Position.Z)
				direct = true
			end
		end
	end
	if not targetPos and #state.path > 0 then
		local c = state.path[1]
		targetPos = cellCenter(c[1], c[2]) + Vector3.new(0, MONSTER_Y, 0)
	end

	if targetPos then
		local delta = targetPos - state.pos
		delta = Vector3.new(delta.X, 0, delta.Z)
		local dist = delta.Magnitude
		if dist < 0.3 then
			if not direct then
				table.remove(state.path, 1)
			end
		else
			local dir = delta.Unit
			state.pos += dir * math.min(dist, monsterSpeed(state) * dt)
			local f = state.facing:Lerp(dir, math.min(1, dt * 8))
			state.facing = if f.Magnitude > 0.05 then f.Unit else dir
		end
	end

	local t = os.clock()
	local bob = math.sin(t * 9) * 0.15
	local sway = math.sin(t * 4.5) * 0.06
	state.model:PivotTo(CFrame.lookAt(state.pos, state.pos + state.facing) * CFrame.new(0, bob, 0) * CFrame.Angles(0, 0, sway))

	-- Attaque
	for player in alive do
		local root = getRoot(player)
		if root then
			local d = root.Position - state.pos
			if Vector3.new(d.X, 0, d.Z).Magnitude < Config.MONSTER_KILL_RANGE and math.abs(d.Y) < 7 then
				state.facing = Vector3.new(d.X, 0, d.Z).Unit
				killPlayer(player)
				state.pauseUntil = os.clock() + 3
				state.path = {}
				state.mode = "wander"
				state.target = nil
				state.lastKnown = nil
				break
			end
		end
	end
end

local function flickerLamp(lamp: Lamp)
	for _ = 1, math.random(3, 8) do
		lamp.light.Enabled = false
		lamp.part.Material = Enum.Material.SmoothPlastic
		task.wait(math.random() * 0.12 + 0.03)
		lamp.light.Enabled = true
		lamp.part.Material = Enum.Material.Neon
		task.wait(math.random() * 0.15 + 0.03)
	end
end

local function runRound()
	roundId += 1
	local myRound = roundId
	local rng = Random.new()

	local maze = Maze.generate(W_CELLS, H_CELLS, Config.BRAID_RATIO, rng)
	currentMaze = maze
	local map, door, doorLight, lamps = buildMap(maze, rng)
	map.Parent = workspace

	keysCollected = 0
	escaped = {}
	table.clear(alive)
	setState("Keys", 0)
	setState("KeysTotal", Config.KEY_COUNT)

	-- Placement des clés : de préférence dans des culs-de-sac loin du départ
	local dist = Maze.distances(maze, 1, 1)
	local deadEnds, others = {}, {}
	for x = 1, W_CELLS do
		for z = 1, H_CELLS do
			local d = dist[x][z]
			if d and d >= 5 and not (x == W_CELLS and z == H_CELLS) then
				table.insert(if Maze.isDeadEnd(maze, x, z) then deadEnds else others, { x, z })
			end
		end
	end
	local function shuffle(t)
		for i = #t, 2, -1 do
			local j = rng:NextInteger(1, i)
			t[i], t[j] = t[j], t[i]
		end
	end
	shuffle(deadEnds)
	shuffle(others)
	local keyCells = {}
	for _, list in { deadEnds, others } do
		for _, c in list do
			if #keyCells >= Config.KEY_COUNT then
				break
			end
			table.insert(keyCells, c)
		end
	end

	local function onAllKeys()
		doorLight.Color = GREEN
		door.Color = Color3.fromRGB(30, 80, 40)
		broadcast("Toutes les clés ! La SORTIE est ouverte... et IL est furieux.", GREEN, 4)
	end

	for _, c in keyCells do
		local key = makePart({
			Name = "Key", Size = Vector3.new(1.4, 0.35, 0.7),
			CFrame = CFrame.new(cellCenter(c[1], c[2]) + Vector3.new(0, 3, 0)),
			Material = Enum.Material.Neon, Color = GOLD, CanCollide = false, Parent = map,
		})
		local glow = Instance.new("PointLight")
		glow.Color = GOLD
		glow.Range = 9
		glow.Brightness = 1.2
		glow.Parent = key
		TweenService:Create(key, TweenInfo.new(2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
			{ CFrame = key.CFrame * CFrame.Angles(0, math.pi, 0) }):Play()

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Ramasser"
		prompt.ObjectText = "Clé rouillée"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.Parent = key
		prompt.Triggered:Connect(function(player)
			if myRound ~= roundId or not alive[player] or not key.Parent then
				return
			end
			key:Destroy()
			keysCollected += 1
			setState("Keys", keysCollected)
			remote:FireClient(player, "KeyPickup")
			broadcast(string.format("%s a trouvé une clé (%d/%d)", player.DisplayName, keysCollected, Config.KEY_COUNT), GOLD, 3)
			if keysCollected >= Config.KEY_COUNT then
				onAllKeys()
			end
		end)
	end

	-- Porte de sortie
	local doorPrompt = Instance.new("ProximityPrompt")
	doorPrompt.ActionText = "S'échapper"
	doorPrompt.ObjectText = "Porte de sortie"
	doorPrompt.HoldDuration = 1.5
	doorPrompt.MaxActivationDistance = 8
	doorPrompt.RequiresLineOfSight = false
	doorPrompt.Parent = door
	doorPrompt.Triggered:Connect(function(player)
		if myRound ~= roundId or not alive[player] then
			return
		end
		if keysCollected < Config.KEY_COUNT then
			tell(player, string.format("Verrouillée... (%d/%d clés)", keysCollected, Config.KEY_COUNT), RED, 2.5)
			return
		end
		removeFromMaze(player)
		table.insert(escaped, player)
		sendToLobby(player)
		broadcast(player.DisplayName .. " s'est échappé !", GREEN, 3)
	end)

	-- Téléporte les joueurs dans l'asile
	local connections: { RBXScriptConnection } = {}
	local spawnPos = cellCenter(1, 1)
	for _, player in Players:GetPlayers() do
		local char = player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if char and hum and hum.Health > 0 then
			alive[player] = true
			player:SetAttribute("InMaze", true)
			char:PivotTo(CFrame.new(spawnPos + Vector3.new(math.random(-3, 3), 4, math.random(-3, 3))) * CFrame.Angles(0, math.pi, 0))
			table.insert(connections, hum.Died:Connect(function()
				if alive[player] then
					removeFromMaze(player)
				end
			end))
		end
	end

	setState("Phase", "Playing")
	broadcast(string.format("Trouve les %d clés et échappe-toi... Ne fais pas de bruit.", Config.KEY_COUNT), Color3.new(1, 1, 1), 5)

	-- Le monstre apparaît dans la case la plus éloignée du départ
	local far, farDist = { W_CELLS, H_CELLS }, -1
	for x = 1, W_CELLS do
		for z = 1, H_CELLS do
			if dist[x][z] and dist[x][z] > farDist then
				far, farDist = { x, z }, dist[x][z]
			end
		end
	end
	local model = buildMonster()
	local state: MonsterState = {
		model = model,
		pos = cellCenter(far[1], far[2]) + Vector3.new(0, MONSTER_Y, 0),
		facing = Vector3.new(0, 0, -1),
		path = {},
		mode = "wander",
		target = nil,
		lastKnown = nil,
		thinkTimer = 0,
		pauseUntil = os.clock() + Config.MONSTER_GRACE,
	}
	model:PivotTo(CFrame.new(state.pos))
	model.Parent = workspace
	monster = state
	task.delay(Config.MONSTER_GRACE, function()
		if myRound == roundId then
			broadcast("Quelque chose s'est réveillé...", RED, 4)
		end
	end)
	table.insert(connections, RunService.Heartbeat:Connect(function(dt)
		updateMonster(state, maze, dt)
	end))

	-- Lampes qui clignotent (beaucoup plus quand le monstre est proche)
	task.spawn(function()
		while myRound == roundId and map.Parent do
			for _, lamp in lamps do
				local near = (lamp.part.Position - state.pos).Magnitude < 28
				if math.random() < (if near then 0.35 else 0.015) then
					task.spawn(flickerLamp, lamp)
				end
			end
			task.wait(0.3)
		end
	end)

	-- Boucle de la manche
	local timeLeft = Config.ROUND_TIME
	while timeLeft > 0 and inMazeCount() > 0 do
		setState("TimeLeft", timeLeft)
		task.wait(1)
		timeLeft -= 1
	end

	-- Temps écoulé : les lumières s'éteignent et il prend tout le monde
	if inMazeCount() > 0 then
		for _, lamp in lamps do
			lamp.light.Enabled = false
			lamp.part.Material = Enum.Material.SmoothPlastic
		end
		broadcast("Le temps est écoulé... les lumières s'éteignent.", RED, 3)
		task.wait(2)
		for player in table.clone(alive) do
			killPlayer(player)
		end
	end

	setState("Phase", "Ended")
	if #escaped > 0 then
		local names = {}
		for _, p in escaped do
			table.insert(names, p.DisplayName)
		end
		broadcast("Survivants : " .. table.concat(names, ", "), GREEN, 5)
	else
		broadcast("Personne n'est sorti de l'asile...", RED, 5)
	end

	task.wait(3)
	roundId += 1 -- invalide les prompts et la boucle des lampes
	for _, c in connections do
		c:Disconnect()
	end
	monster = nil
	currentMaze = nil
	model:Destroy()
	map:Destroy()
	for player in table.clone(alive) do
		removeFromMaze(player)
		sendToLobby(player)
	end
end

----------------------------------------------------------------------
-- Joueurs
----------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player:SetAttribute("InMaze", false)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in Players:GetPlayers() do
	onPlayerAdded(p)
end

Players.PlayerRemoving:Connect(function(player)
	alive[player] = nil
	flashlightOn[player] = nil
end)

-- Le client indique si sa lampe est allumée (la lumière attire le monstre)
remote.OnServerEvent:Connect(function(player, action, value)
	if action == "Flashlight" and typeof(value) == "boolean" then
		flashlightOn[player] = value
	end
end)

----------------------------------------------------------------------
-- Démarrage
----------------------------------------------------------------------
Players.RespawnTime = 4
setupLighting()
buildLobby()
setState("Phase", "Lobby")
setState("Keys", 0)
setState("KeysTotal", Config.KEY_COUNT)

while true do
	setState("Phase", "Lobby")
	while #Players:GetPlayers() < Config.MIN_PLAYERS do
		setState("TimeLeft", -1)
		task.wait(1)
	end
	for t = Config.INTERMISSION, 1, -1 do
		setState("TimeLeft", t)
		task.wait(1)
	end
	local ok, err = pcall(runRound)
	if not ok then
		warn("[Horreur] Erreur pendant la manche :", err)
		roundId += 1
		monster = nil
		local leftover = workspace:FindFirstChild("Asylum")
		if leftover then leftover:Destroy() end
		local entity = workspace:FindFirstChild("TheEntity")
		if entity then entity:Destroy() end
		for player in table.clone(alive) do
			removeFromMaze(player)
			sendToLobby(player)
		end
	end
end
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000009"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000008"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000007"><Properties><string name="Name">HorrorClient</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- HorrorClient (LocalScript dans StarterPlayer > StarterPlayerScripts)
-- Lampe torche, course/endurance, effets de peur, screamers et interface.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage:WaitForChild("HorrorConfig"))
local remote = ReplicatedStorage:WaitForChild("HorrorEvent") :: RemoteEvent

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

----------------------------------------------------------------------
-- Sons (optionnels)
----------------------------------------------------------------------
local function makeSound(id: string?, looped: boolean, volume: number): Sound?
	if not id or id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = looped
	s.Volume = volume
	s.Parent = SoundService
	return s
end

local sounds = {
	Ambient = makeSound(Config.SOUNDS.Ambient, true, 0.4),
	Heartbeat = makeSound(Config.SOUNDS.Heartbeat, true, 0),
	Scream = makeSound(Config.SOUNDS.Scream, false, 1),
	Sting = makeSound(Config.SOUNDS.Sting, false, 0.8),
	Whisper = makeSound(Config.SOUNDS.Whisper, false, 0.6),
	KeyPickup = makeSound(Config.SOUNDS.KeyPickup, false, 0.7),
	Flashlight = makeSound(Config.SOUNDS.Flashlight, false, 0.5),
}
if sounds.Ambient then sounds.Ambient:Play() end
if sounds.Heartbeat then sounds.Heartbeat:Play() end

local function play(name: string)
	local s = (sounds :: any)[name] :: Sound?
	if s then
		s.TimePosition = 0
		s:Play()
	end
end

----------------------------------------------------------------------
-- Interface
----------------------------------------------------------------------
local function create(className: string, props: { [string]: any }): Instance
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local gui = create("ScreenGui", {
	Name = "HorrorUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 5,
	Parent = player:WaitForChild("PlayerGui"),
}) :: ScreenGui

-- Vignette (4 dégradés noirs sur les bords)
local vignetteFrames = {}
for _, rot in { 0, 90, 180, 270 } do
	local f = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 1, Parent = gui,
	})
	create("UIGradient", {
		Rotation = rot,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 1),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = f,
	})
	table.insert(vignetteFrames, f)
end

local redOverlay = create("Frame", {
	Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(140, 0, 0),
	BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = gui,
}) :: Frame

local function label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Creepster,
		TextScaled = true, TextStrokeTransparency = 0.4, ZIndex = 5, Parent = gui,
	}
	for k, v in props do
		base[k] = v
	end
	return create("TextLabel", base) :: TextLabel
end

local statusLabel = label({ Size = UDim2.new(0.5, 0, 0, 36), Position = UDim2.new(0.25, 0, 0, 12) })
local keysLabel = label({
	Size = UDim2.new(0, 220, 0, 34), Position = UDim2.new(0, 16, 0, 12),
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 200, 60),
})
local messageLabel = label({
	Size = UDim2.new(0.8, 0, 0, 48), Position = UDim2.new(0.1, 0, 0.68, 0), TextTransparency = 1, TextStrokeTransparency = 1,
})
local whisperLabel = label({
	Size = UDim2.new(0, 320, 0, 30), TextTransparency = 1, TextStrokeTransparency = 1,
	TextColor3 = Color3.fromRGB(170, 0, 0), Font = Enum.Font.Antique,
})
label({
	Size = UDim2.new(0, 360, 0, 22), Position = UDim2.new(1, -376, 1, -34), Font = Enum.Font.GothamMedium,
	TextColor3 = Color3.fromRGB(150, 150, 150), TextXAlignment = Enum.TextXAlignment.Right,
	Text = "[F] Lampe   [Maj] Courir", TextStrokeTransparency = 1,
})

local function bar(name: string, y: number, color: Color3): Frame
	local holder = create("Frame", {
		Size = UDim2.new(0, 200, 0, 10), Position = UDim2.new(0, 16, 1, y),
		BackgroundColor3 = Color3.fromRGB(20, 20, 20), BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 5, Parent = gui,
	})
	create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = holder })
	label({
		Size = UDim2.new(0, 200, 0, 16), Position = UDim2.new(0, 16, 1, y - 18), Text = name, Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(180, 180, 180), TextStrokeTransparency = 1,
	})
	local fill = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 6, Parent = holder,
	}) :: Frame
	create("UICorner", { CornerRadius = UDim.new(0, 4), Parent = fill })
	return fill
end
local staminaFill = bar("Endurance", -60, Color3.fromRGB(220, 220, 220))
local batteryFill = bar("Pile", -24, Color3.fromRGB(255, 210, 80))

-- Effets de post-traitement locaux
local fearCC = create("ColorCorrectionEffect", { Name = "FearCC", Parent = Lighting }) :: ColorCorrectionEffect
local fearBlur = create("BlurEffect", { Name = "FearBlur", Size = 0, Parent = Lighting }) :: BlurEffect

----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------
local messageToken = 0
local function showMessage(text: string, color: Color3?, duration: number?)
	messageToken += 1
	local token = messageToken
	messageLabel.Text = text
	messageLabel.TextColor3 = color or Color3.new(1, 1, 1)
	TweenService:Create(messageLabel, TweenInfo.new(0.3), { TextTransparency = 0, TextStrokeTransparency = 0.4 }):Play()
	task.delay(duration or 3, function()
		if token == messageToken then
			TweenService:Create(messageLabel, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end

local function inMaze(): boolean
	return player:GetAttribute("InMaze") == true
end

----------------------------------------------------------------------
-- Statut de la partie
----------------------------------------------------------------------
local function formatTime(t: number): string
	return string.format("%d:%02d", t // 60, t % 60)
end

local function updateStatus()
	local phase = ReplicatedStorage:GetAttribute("Phase")
	local t = ReplicatedStorage:GetAttribute("TimeLeft") or 0
	local keys = ReplicatedStorage:GetAttribute("Keys") or 0
	local total = ReplicatedStorage:GetAttribute("KeysTotal") or Config.KEY_COUNT
	if phase == "Lobby" then
		statusLabel.Text = if t < 0 then "En attente de joueurs..." else "L'asile ouvre ses portes dans " .. t
		keysLabel.Text = ""
	elseif phase == "Playing" then
		statusLabel.Text = if inMaze() then formatTime(t) else "Manche en cours — " .. formatTime(t)
		keysLabel.Text = string.format("Clés : %d / %d", keys, total)
	else
		statusLabel.Text = "Fin de la manche"
	end
end
for _, attr in { "Phase", "TimeLeft", "Keys", "KeysTotal" } do
	ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(updateStatus)
end
player:GetAttributeChangedSignal("InMaze"):Connect(updateStatus)
updateStatus()

----------------------------------------------------------------------
-- Lampe torche
----------------------------------------------------------------------
local flashPart = create("Part", {
	Name = "Flashlight", Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1, Anchored = true,
	CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Parent = camera,
}) :: Part
local spot = create("SpotLight", {
	Face = Enum.NormalId.Front, Range = 50, Angle = 55, Brightness = 4, Shadows = true,
	Color = Color3.fromRGB(255, 238, 205), Enabled = false, Parent = flashPart,
}) :: SpotLight
-- Petite lueur autour du joueur pour ne pas être dans le noir total
create("PointLight", { Range = 7, Brightness = 0.25, Color = Color3.fromRGB(150, 160, 200), Parent = flashPart })

local flashlightOn = false
local battery = Config.BATTERY_MAX
local stamina = Config.STAMINA_MAX
local exhausted = false
local sprintHeld = false

local function setFlashlight(on: boolean)
	if on and battery < 5 then
		showMessage("Plus de pile...", Color3.fromRGB(200, 200, 200), 1.5)
		on = false
	end
	if on == flashlightOn then
		return
	end
	flashlightOn = on
	spot.Enabled = on
	play("Flashlight")
	remote:FireServer("Flashlight", on)
end

ContextActionService:BindAction("HorrorFlashlight", function(_, state)
	if state == Enum.UserInputState.Begin then
		setFlashlight(not flashlightOn)
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.F, Enum.KeyCode.ButtonR1)
ContextActionService:SetTitle("HorrorFlashlight", "Lampe")

ContextActionService:BindAction("HorrorSprint", function(_, state)
	sprintHeld = state == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Pass
end, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
ContextActionService:SetTitle("HorrorSprint", "Courir")

player.CharacterAdded:Connect(function()
	stamina = Config.STAMINA_MAX
	exhausted = false
end)

----------------------------------------------------------------------
-- Screamer
----------------------------------------------------------------------
local shakeBoost = 0

local function jumpscare()
	play("Scream")
	shakeBoost = 1.5
	setFlashlight(false)

	local frame = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 50, Parent = gui,
	}) :: Frame
	local entity = workspace:FindFirstChild("TheEntity") :: Model?
	if entity then
		local vp = create("ViewportFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 51,
			Ambient = Color3.fromRGB(160, 50, 50), LightColor = Color3.fromRGB(255, 90, 90),
			LightDirection = Vector3.new(0, -0.5, 1), Parent = frame,
		}) :: ViewportFrame
		local clone = entity:Clone()
		clone:PivotTo(CFrame.new())
		clone.Parent = vp
		local vpCam = Instance.new("Camera")
		vpCam.FieldOfView = 70
		vpCam.Parent = vp
		vp.CurrentCamera = vpCam
		local head = clone:FindFirstChild("Head") :: BasePart?
		local face = if head then head.Position else Vector3.new(0, 5, 0)
		-- Le monstre regarde vers -Z : la caméra se place devant son visage
		vpCam.CFrame = CFrame.lookAt(face + Vector3.new(0, -0.4, -10), face)
		TweenService:Create(vpCam, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			CFrame = CFrame.lookAt(face + Vector3.new(0, -0.1, -2.3), face),
		}):Play()
		task.spawn(function()
			task.wait(0.2)
			local base = vpCam.CFrame
			local start = os.clock()
			while os.clock() - start < 1.8 and vp.Parent do
				local s = 0.12
				vpCam.CFrame = base * CFrame.new(math.random() * s - s / 2, math.random() * s - s / 2, 0)
					* CFrame.Angles(0, 0, (math.random() - 0.5) * 0.08)
				RunService.RenderStepped:Wait()
			end
		end)
	end
	local flash = create("Frame", {
		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 60, Parent = frame,
	}) :: Frame
	TweenService:Create(flash, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
	local text = label({
		Size = UDim2.new(1, 0, 0.15, 0), Position = UDim2.fromScale(0, 0.78), Text = "IL T'A TROUVÉ",
		TextColor3 = Color3.fromRGB(220, 0, 0), ZIndex = 61, Parent = frame,
	})
	for _ = 1, 4 do
		task.wait(0.12)
		frame.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
		task.wait(0.08)
		frame.BackgroundColor3 = Color3.new(0, 0, 0)
	end
	task.wait(1.4)
	local fade = TweenInfo.new(1)
	TweenService:Create(frame, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(text, fade, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	local vp = frame:FindFirstChildOfClass("ViewportFrame")
	if vp then
		TweenService:Create(vp, fade, { ImageTransparency = 1, BackgroundTransparency = 1 }):Play()
	end
	task.wait(1)
	frame:Destroy()
end

-- Apparition fantôme : le monstre apparaît une fraction de seconde au bout du couloir
local function phantomScare()
	local entity = workspace:FindFirstChild("TheEntity") :: Model?
	local char = player.Character
	if not entity or not char then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, camera, entity }
	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	flat = flat.Unit
	local hit = workspace:Raycast(origin, flat * 60, params)
	local dist = if hit then hit.Distance else 60
	if dist < 18 then
		return
	end
	local pos = origin + flat * (dist - 3)
	local ghost = entity:Clone()
	ghost:PivotTo(CFrame.lookAt(Vector3.new(pos.X, 4.5, pos.Z), Vector3.new(origin.X, 4.5, origin.Z)))
	ghost.Parent = camera
	play("Sting")
	task.wait(0.15 + math.random() * 0.15)
	ghost:Destroy()
end

local WHISPERS = {
	"...derrière toi...", "tu entends ?", "il arrive", "ne te retourne pas", "reste avec nous",
	"cours", "il sent ta lumière", "...", "on t'attendait",
}

task.spawn(function()
	while true do
		task.wait(math.random(20, 45))
		if inMaze() then
			if math.random() < 0.35 then
				phantomScare()
			else
				play("Whisper")
				whisperLabel.Text = WHISPERS[math.random(1, #WHISPERS)]
				whisperLabel.Position = UDim2.new(math.random(10, 70) / 100, 0, math.random(20, 75) / 100, 0)
				TweenService:Create(whisperLabel, TweenInfo.new(1.2), { TextTransparency = 0.2 }):Play()
				task.wait(2)
				TweenService:Create(whisperLabel, TweenInfo.new(1.5), { TextTransparency = 1 }):Play()
			end
		end
	end
end)

----------------------------------------------------------------------
-- Événements serveur
----------------------------------------------------------------------
remote.OnClientEvent:Connect(function(action, a, b, c)
	if action == "Message" then
		showMessage(a, b, c)
	elseif action == "Jumpscare" then
		task.spawn(jumpscare)
	elseif action == "Spotted" then
		play("Sting")
		shakeBoost = math.max(shakeBoost, 0.4)
		redOverlay.BackgroundTransparency = 0.6
		TweenService:Create(redOverlay, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
	elseif action == "KeyPickup" then
		play("KeyPickup")
	end
end)

----------------------------------------------------------------------
-- Boucle par frame
----------------------------------------------------------------------
local fear = 0
local bobTime = 0

RunService.RenderStepped:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local frozen = char ~= nil and char:GetAttribute("Frozen") == true
	local playing = inMaze()

	-- Course / endurance
	local moving = hum ~= nil and hum.MoveDirection.Magnitude > 0.1
	local sprinting = sprintHeld and moving and not exhausted and not frozen
	if sprinting then
		stamina -= Config.STAMINA_DRAIN * dt
		if stamina <= 0 then
			stamina = 0
			exhausted = true
			showMessage("À bout de souffle...", Color3.fromRGB(200, 200, 200), 1.5)
		end
	else
		stamina = math.min(Config.STAMINA_MAX, stamina + Config.STAMINA_REGEN * dt)
		if exhausted and stamina >= Config.STAMINA_MAX * 0.35 then
			exhausted = false
		end
	end
	if hum then
		local speed = if frozen then 0 elseif sprinting then Config.SPRINT_SPEED else Config.WALK_SPEED
		if hum.WalkSpeed ~= speed then
			hum.WalkSpeed = speed
		end
	end
	staminaFill.Size = UDim2.fromScale(stamina / Config.STAMINA_MAX, 1)
	staminaFill.BackgroundColor3 = if exhausted then Color3.fromRGB(180, 60, 60) else Color3.fromRGB(220, 220, 220)

	-- Pile
	if flashlightOn and playing then
		battery -= Config.BATTERY_DRAIN * dt
		if battery <= 0 then
			battery = 0
			setFlashlight(false)
			showMessage("Ta lampe s'est éteinte...", Color3.fromRGB(200, 200, 200), 2)
		end
	elseif not flashlightOn then
		battery = math.min(Config.BATTERY_MAX, battery + Config.BATTERY_REGEN * dt)
	end
	batteryFill.Size = UDim2.fromScale(battery / Config.BATTERY_MAX, 1)

	-- Peur : selon la distance au monstre
	local target = 0
	local entity = workspace:FindFirstChild("TheEntity") :: Model?
	if entity and playing and root then
		local d = (entity:GetPivot().Position - root.Position).Magnitude
		target = math.clamp(1 - (d - 10) / 55, 0, 1)
	end
	fear += (target - fear) * math.min(1, dt * 3)

	-- La lampe grésille quand il est proche
	if flashlightOn then
		local flicker = fear > 0.45 and math.random() < fear * 0.3
		spot.Enabled = not flicker
		spot.Brightness = 4 - (if flicker then 0 else math.random() * fear * 2)
	end

	-- Effets visuels
	local t = os.clock()
	local pulse = (math.sin(t * (4 + fear * 8)) + 1) / 2
	fearCC.Saturation = -fear * 0.6
	fearCC.Contrast = fear * 0.2
	fearCC.TintColor = Color3.new(1, 1 - fear * 0.35, 1 - fear * 0.35)
	fearBlur.Size = fear * 5
	if redOverlay.BackgroundTransparency > 0.95 or fear > 0.3 then
		redOverlay.BackgroundTransparency = 1 - fear * 0.18 * pulse
	end
	for _, f in vignetteFrames do
		f.BackgroundTransparency = 0.35 - fear * 0.3
	end
	if sounds.Heartbeat then
		sounds.Heartbeat.Volume = fear * 1.2
		sounds.Heartbeat.PlaybackSpeed = 0.9 + fear * 0.6
	end

	-- Balancement de la tête en marchant
	if hum then
		if moving and not frozen then
			bobTime += dt * (if sprinting then 14 else 9)
			local amp = if sprinting then 1.6 else 1
			hum.CameraOffset = Vector3.new(math.cos(bobTime) * 0.08 * amp, math.abs(math.sin(bobTime)) * 0.14 * amp, 0)
		else
			hum.CameraOffset = hum.CameraOffset:Lerp(Vector3.zero, math.min(1, dt * 6))
		end
	end
end)

-- Après la caméra : tremblement + position de la lampe
RunService:BindToRenderStep("HorrorCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	shakeBoost = math.max(0, shakeBoost - dt * 1.5)
	local s = fear * fear * 0.01 + shakeBoost * 0.03
	if s > 0.0005 then
		camera.CFrame *= CFrame.Angles((math.random() - 0.5) * s, (math.random() - 0.5) * s, 0)
	end
	local goal = camera.CFrame * CFrame.new(0.6, -0.5, -0.5)
	flashPart.CFrame = flashPart.CFrame:Lerp(goal, math.min(1, dt * 18))
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>
